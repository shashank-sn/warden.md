{
  "name": "warden-md",
  "version": "0.1.0",
  "private": true,
  "description": "Agent auth that ends when the work does.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate:deploy": "pnpm --filter @warden/service validate:deploy",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm validate:deploy && pnpm test && pnpm build",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-action-cli-version.mjs",
    "release:publish": "pnpm --filter @warden/cli build && changeset publish",
    "demo:broker": "tsx examples/completion-flow.ts",
    "demo:service": "tsx examples/service-demo/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
