{
  "name": "@warden/service",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted auth.md service reference for Cloudflare Workers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "provision": "node scripts/provision.mjs",
    "reset": "node scripts/reset.mjs",
    "seed": "node scripts/seed.mjs"
  }
}
