{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warden-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "d1_databases": [
    {
      "binding": "BROKER_DB",
      "database_name": "warden-broker",
      "database_id": "replace-at-deploy",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BROKER_COORDINATOR", "class_name": "BrokerCoordinatorDurableObject" },
      { "name": "GRANT_EXPIRY", "class_name": "GrantExpiryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["GrantExpiryDurableObject"] },
    { "tag": "v2", "new_classes": ["BrokerCoordinatorDurableObject"] }
  ]
}
