{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "authmd canonical conformance artifact",
  "type": "object",
  "required": ["schemaVersion", "subject", "findings", "summary"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "subject": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "severity", "message"],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "enum": ["error", "warning", "info"]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["errorCount", "warningCount", "infoCount"]
    }
  }
}
